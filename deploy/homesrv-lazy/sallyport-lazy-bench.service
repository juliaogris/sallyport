[Unit]
Description=sallyport lazy bench static server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/julia/sallyport-lazy
ExecStart=/usr/bin/python3 -m http.server 18380 --bind 127.0.0.1 --directory /home/julia/sallyport-lazy/bench
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
