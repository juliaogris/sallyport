[Unit]
Description=sallyport bench static server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/julia/sallyport
ExecStart=/usr/bin/python3 -m http.server 18080 --bind 127.0.0.1 --directory /home/julia/sallyport/bench
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
