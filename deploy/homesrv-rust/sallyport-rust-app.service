[Unit]
Description=sallyport rust app service
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/julia/sallyport-rust
Environment=TELEPORT_TLS_ROUTING_CONN_UPGRADE=yes
ExecStart=/home/julia/sallyport/teleport-18.11.1/teleport start --config=/home/julia/sallyport-rust/deploy/app.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
