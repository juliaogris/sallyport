[Unit]
Description=sallyport rust bench static server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/julia/sallyport-rust
ExecStart=/usr/bin/python3 -m http.server 18180 --bind 127.0.0.1 --directory /home/julia/sallyport-rust/bench
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
