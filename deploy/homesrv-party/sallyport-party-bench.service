[Unit]
Description=sallyport party bench static server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/julia/sallyport-party
ExecStart=/usr/bin/python3 -m http.server 18480 --bind 127.0.0.1 --directory /home/julia/sallyport-party/bench
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
